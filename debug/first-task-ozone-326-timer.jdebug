// Ozone 3.26: observe continuous tick growth in the already programmed target.
// Close other debuggers and reconnect DAPLink USB before opening this project.
void OnProjectLoad(void) {
  Project.SetDevice("STM32F103C6");
  Project.SetHostIF("USB", "1047408020");
  Project.SetTargetIF("SWD");
  Project.SetTIFSpeed("100 kHz");
  Debug.SetConnectMode(CM_ATTACH);
  Project.SetConsoleLogFile("$(ProjectDir)/first-task-ozone-326-timer.log");
  Project.SetJLinkLogFile("$(ProjectDir)/first-task-jlink-326-timer.log");
  File.Open("$(ProjectDir)/../build/first-task-timer.elf");
}
